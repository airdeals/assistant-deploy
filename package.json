{
  "name": "personal-ai-assistant-deploy",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Деплой-репозиторий личного AI-помощника: код без секретов, Node без root, PGlite вместо Docker Postgres. Серверу нужны только dist/ (собранные бандлы) и лёгкий npm install --omit=dev.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "migrate": "node dist/db/migrate.js",
    "migrate:down": "node dist/db/migrate.js down",
    "db:smoke": "node dist/db/smoke.js",
    "db:local-verify": "node scripts/db-local-verify.mjs",
    "db:server": "node scripts/db-server.mjs",
    "bot": "node dist/bot/bot.js",
    "start": "node dist/api/server.js",
    "import": "node dist/cli/importCli.js",
    "start:demo": "node --import tsx scripts/start-demo.mjs",
    "demo:smoke": "node scripts/smoke-demo-shutdown.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@electric-sql/pglite-socket": "^0.2.11",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
