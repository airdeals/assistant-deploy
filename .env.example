# Локальная разработка. Секреты здесь только как примеры для изолированного dev-окружения.
DATABASE_URL=postgres://assistant:assistant@127.0.0.1:5433/assistant
POSTGRES_PASSWORD=assistant

# --- G2-4: семантический поиск (активация отложена протоколом G0-6) ---
# OpenAI-совместимый endpoint эмбеддингов. Без этих переменных
# /search/semantic честно деградирует с 503 (AT-25).
# EMBEDDINGS_BASE_URL=https://api.example.com/v1
# EMBEDDINGS_API_KEY=...
# EMBEDDINGS_MODEL=text-embedding-3-small

# --- G4: live-адаптеры ---
# Webhook WA-2 (coexistence): app secret для X-Hub-Signature-256.
# WA2_APP_SECRET=...
# WAHA_BASE_URL=http://127.0.0.1:3000
# WAHA_API_KEY=...
# WAHA_SESSION=default
# TDLib (tg1/tg2, два аккаунта = два инстанса с разным TG_DATABASE_DIR):
# TG_API_ID=12345
# TG_API_HASH=...
# TD_JSON_CLI=tdlib-json
